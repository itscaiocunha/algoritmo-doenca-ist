# Copie para `.env` e ajuste conforme necessário.
# Sem um `.env`, o docker-compose usa exatamente os valores abaixo como padrão.

# --- PostgreSQL ---
POSTGRES_USER=admin_ist
POSTGRES_PASSWORD=istunifeob
POSTGRES_DB=ist_db
POSTGRES_PORT=5432

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_PORT=3000

# --- Jenkins ---
JENKINS_PORT=8080
JENKINS_AGENT_PORT=50000
